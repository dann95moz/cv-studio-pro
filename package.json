{
  "name": "mi-cv-engine",
  "version": "1.0.0",
  "description": "Privacy-first ATS resume tailoring and PDF studio with Google XYZ bullet synthesis and real-time quality audit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:compliance": "node scripts/audit-codebase.mjs",
    "pdf": "tsx src/cli/index.ts pdf",
    "pdf:all": "tsx src/cli/index.ts pdf:all",
    "pdf:modern": "tsx src/cli/index.ts pdf --theme modern-tech",
    "pdf:executive": "tsx src/cli/index.ts pdf --theme executive",
    "pdf:ats": "tsx src/cli/index.ts pdf --theme minimal-ats",
    "pdf:two-column": "tsx src/cli/index.ts pdf --theme two-column",
    "pdf:designer": "tsx src/cli/index.ts pdf --theme designer-uiux",
    "pdf:formal": "tsx src/cli/index.ts pdf --theme formal-legal",
    "pdf:academic": "tsx src/cli/index.ts pdf --theme academic-research",
    "themes": "tsx src/cli/index.ts themes",
    "palettes": "tsx src/cli/index.ts palettes",
    "models": "tsx src/cli/index.ts models",
    "generate": "tsx src/cli/index.ts generate",
    "tailor": "tsx src/cli/index.ts generate",
    "audit": "tsx src/cli/index.ts audit",
    "quality": "tsx src/cli/index.ts audit",
    "wizard": "tsx src/cli/index.ts wizard",
    "cli": "tsx src/cli/index.ts wizard",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node18 --format=esm --packages=external --minify --outfile=bin/cli.mjs",
    "prepublishOnly": "npm run build:cli"
  },
  "bin": {
    "cv-engine": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "src/themes"
  ],
  "keywords": [
    "cv",
    "resume",
    "typescript",
    "react",
    "vite",
    "pdf-generator",
    "puppeteer",
    "gemini-ai",
    "ats-friendly"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.14",
    "dotenv": "^16.4.7",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "marked": "^15.0.7",
    "pdfjs-dist": "^6.3.289",
    "puppeteer": "^24.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
